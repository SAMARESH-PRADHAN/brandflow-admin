# Backend API URL (used by fetch). Defaults to /api which Vite proxies in dev.
#!for render
VITE_API_URL= https://brandflow-admin.onrender.com/api
#!for local
# VITE_API_URL=http://localhost:3000/api
# Vite dev proxy target (optional). Backend port from backend/.env
# VITE_API_PROXY=http://localhost:3000
